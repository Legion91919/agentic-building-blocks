<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names use underscores; tests await without ConfigureAwait; test classes are public by xUnit convention. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1062;CA1861;CA2000;CA1849;CA5394</NoWarn>
  </PropertyGroup>
</Project>
